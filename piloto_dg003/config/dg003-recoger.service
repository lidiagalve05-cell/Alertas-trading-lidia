[Unit]
Description=DG-003 recopilador experimental
After=network-online.target time-sync.target
[Service]
Type=oneshot
User=dg003-recoger
WorkingDirectory=/opt/dg003
EnvironmentFile=/etc/dg003/recoger.env
StateDirectory=dg003-recoger
StateDirectoryMode=0755
ExecStart=/usr/bin/python3 -m piloto_dg003.piloto recoger --inicio-utc ${INICIO_DG003} --carpeta /var/lib/dg003-recoger
ExecCondition=/bin/sh -ec '/usr/bin/timedatectl show -p NTPSynchronized --value | /usr/bin/grep -qx yes'
TimeoutStartSec=50s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
